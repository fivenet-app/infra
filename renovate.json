{
  "extends": [
    "github>nuxt/renovate-config-nuxt"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    }
  ],
  "platformAutomerge": true,
  "nix": {
    "enabled": true
  },
  "minimumReleaseAge": "16 hours"
}